<template>
  <div class="page page-audio-workshop" style="height: 100%; overflow: hidden;">
    <!-- Compact Top Navbar -->
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <span class="badge color-blue" style="font-weight: 800; letter-spacing: 0.5px;">
            <i class="icon t4-icons" style="font-size: 13px; vertical-align: middle;">waveform_path</i>
            8-FILTER SYNTH
          </span>
        </div>
        <div class="title" style="font-size: 14px; font-weight: 800; letter-spacing: 0.5px;">SUBUNDERGRUND ELECTRONIC</div>
        <div class="right">
          <button class="button button-small button-fill color-red" style="font-size: 10px; height: 24px; line-height: 24px; font-weight: 700; padding: 0 8px;" @click=${panicAllNotesOff}>
            PANIC
          </button>
        </div>
      </div>
    </div>

    <!-- 100% Height Non-Scrolling View Container -->
    <div
      class="page-content"
      style="height: 100%; max-height: 100%; overflow: hidden !important; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; padding: calc(var(--t4-page-navbar-offset, 44px) + 2px) 6px calc(var(--t4-page-toolbar-bottom-offset, 48px) + 2px) 6px !important; gap: 4px;"
    >
      <!-- Row 1: Compact 12 Instrument Presets Bar -->
      <div
        class="presets-bar"
        style="display: flex; gap: 4px; overflow-x: auto; flex-shrink: 0; padding: 1px 0; -webkit-overflow-scrolling: touch;"
      >
        ${presets.map((p) => $h`
          <button
            class="button button-small preset-btn ${p.id === activePreset.id ? 'preset-active' : ''}"
            style="flex: 1; min-width: 100px; height: 26px; line-height: 24px; padding: 0 6px; font-size: 10px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 4px; border-radius: 5px;"
            @click=${() => selectInstrument(p.id)}
          >
            <i class="icon t4-icons" style="font-size: 12px;">${p.icon || 'waveform_path'}</i>
            <span>${p.name}</span>
          </button>
        `)}
      </div>

      <!-- Row 2: Large Oscilloscope & Master Controls Deck (Split View) -->
      <div style="display: flex; gap: 6px; flex: 1.3; min-height: 135px; max-height: 240px; align-items: stretch;">
        <!-- Left: Large High-Tech Cyber Oscilloscope Display -->
        <div
          class="oscilloscope-container"
          style="flex: 2; position: relative; background: #040711; border-radius: 7px; overflow: hidden; border: 1px solid rgba(0, 240, 255, 0.3); box-shadow: inset 0 0 25px rgba(0,0,0,0.9), 0 0 10px rgba(0, 240, 255, 0.08); min-width: 150px; display: flex;"
        >
          <canvas id="audio-workshop-canvas" style="width: 100%; height: 100%; display: block;"></canvas>

          <!-- Top-Left HUD Overlay: Live FPS & Benchmark Button -->
          <div style="position: absolute; top: 4px; left: 6px; display: flex; align-items: center; gap: 4px; z-index: 5;">
            <div
              style="background: rgba(4, 7, 17, 0.88); border: 1px solid rgba(0, 240, 255, 0.35); border-radius: 4px; color: #00f0ff; font-family: monospace; font-size: 8.5px; font-weight: 700; padding: 1px 6px; display: flex; align-items: center; gap: 4px;"
            >
              <span id="ws-fps-stat">60.0 FPS</span>
              <span style="color: #475569;">|</span>
              <span id="ws-ft-stat">16.6ms</span>
            </div>
            <button
              class="button button-small button-fill color-teal"
              style="font-size: 8px; height: 18px; line-height: 18px; font-weight: 800; padding: 0 6px; border-radius: 4px; letter-spacing: 0.3px; cursor: pointer; box-shadow: 0 0 6px rgba(0, 240, 255, 0.25);"
              @click=${openBenchmarkModal}
            >
              ⚡ BENCHMARK
            </button>
          </div>

          <!-- Top HUD Overlay Badges -->
          <div style="position: absolute; top: 4px; right: 6px; display: flex; gap: 4px; pointer-events: none;">
            <span class="badge color-blue" style="font-size: 8.5px; padding: 1px 5px; font-weight: 700;">${activePreset.name}</span>
            <span class="badge color-purple" style="font-size: 8.5px; padding: 1px 5px; font-weight: 700;">${activePreset.waveform.toUpperCase()}</span>
            <span id="ws-voice-count-badge" class="badge color-gray" style="font-size: 8.5px; padding: 1px 5px; font-weight: 700;">VOICES: 0</span>
          </div>

          <!-- Bottom HUD Overlay: Scale & Frequency Axis Markers -->
          <div style="position: absolute; bottom: 3px; left: 6px; display: flex; gap: 8px; pointer-events: none; font-size: 8px; font-family: monospace; color: rgba(0, 240, 255, 0.6); font-weight: 700; letter-spacing: 0.5px;">
            <span>CH1: 50mV/DIV</span>
            <span>TIME: 2.5ms</span>
            <span>POLYPHONIC 8-VOICE</span>
          </div>
        </div>

        <!-- Right: Analog Rotary Controls Deck (Round Range Sliders) -->
        <div
          class="rotary-controls-deck"
          style="display: flex; align-items: center; background: #080d19; border-radius: 7px; padding: 2px 5px; box-sizing: border-box; border: 1px solid #1a253a; gap: 3px; flex-shrink: 0;"
        >
          <!-- Circular Slider 1: Master Volume -->
          <div
            class="round-range-slider round-range-slider-init"
            id="ws-volume-knob"
            data-mode="0+"
            data-min="0"
            data-max="100"
            data-value="75"
            data-default-value="75"
            data-title="VOL"
            data-unit="%"
            data-size="42"
            data-stroke-width="3"
            style="margin: 0 1px !important;"
          ></div>

          <!-- Circular Slider 2: Master Cutoff Offset -->
          <div
            class="round-range-slider round-range-slider-init"
            id="ws-cutoff-knob"
            data-mode="-0+"
            data-min="-24"
            data-max="24"
            data-value="0"
            data-default-value="0"
            data-snap="true"
            data-snap-values="[0]"
            data-title="CUTOFF"
            data-unit="st"
            data-size="42"
            data-stroke-width="3"
            style="margin: 0 1px !important;"
          ></div>

          <!-- Circular Slider 3: Resonance Multiplier -->
          <div
            class="round-range-slider round-range-slider-init"
            id="ws-res-knob"
            data-mode="0+"
            data-min="0.2"
            data-max="3.0"
            data-step="0.1"
            data-value="1.0"
            data-default-value="1.0"
            data-title="RESO"
            data-unit="x"
            data-size="42"
            data-stroke-width="3"
            style="margin: 0 1px !important;"
          ></div>

          <!-- Circular Slider 4: Detune -->
          <div
            class="round-range-slider round-range-slider-init"
            id="ws-detune-knob"
            data-mode="-0+"
            data-min="-50"
            data-max="50"
            data-value="0"
            data-default-value="0"
            data-snap="true"
            data-snap-values="[0]"
            data-title="DETUNE"
            data-unit="c"
            data-size="42"
            data-stroke-width="3"
            style="margin: 0 1px !important;"
          ></div>

          <!-- Quick Waveform & Demo strip -->
          <div style="display: flex; flex-direction: column; justify-content: space-between; height: 86px; width: 62px; flex-shrink: 0; padding-left: 1px;">
            <div class="segmented segmented-raised" style="height: 19px;">
              <button class="button ${activePreset.waveform === 'sawtooth' ? 'button-active' : ''}" style="font-size: 8px; line-height: 17px; padding: 0;" @click=${() => setWaveform('sawtooth')}>SAW</button>
              <button class="button ${activePreset.waveform === 'square' ? 'button-active' : ''}" style="font-size: 8px; line-height: 17px; padding: 0;" @click=${() => setWaveform('square')}>SQR</button>
            </div>
            <div class="segmented segmented-raised" style="height: 19px;">
              <button class="button ${activePreset.waveform === 'triangle' ? 'button-active' : ''}" style="font-size: 8px; line-height: 17px; padding: 0;" @click=${() => setWaveform('triangle')}>TRI</button>
              <button class="button ${activePreset.waveform === 'sine' ? 'button-active' : ''}" style="font-size: 8px; line-height: 17px; padding: 0;" @click=${() => setWaveform('sine')}>SIN</button>
            </div>
            <button
              id="ws-demo-btn"
              class="button button-small button-fill ${isDemoPlaying ? 'color-orange' : 'color-blue'}"
              style="height: 22px; line-height: 22px; font-size: 9px; padding: 0 2px;"
              @click=${playDemoMelody}
            >
              ${isDemoPlaying ? 'Stop' : 'Demo'}
            </button>
          </div>
        </div>
      </div>

      <!-- Row 3: Compact Eurorack 8-Filter Modular Rack -->
      <div
        class="filter-rack-panel"
        style="height: 88px; flex-shrink: 0; background: #080d1a; border: 1px solid #1a2438; border-radius: 7px; padding: 2px 4px; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box;"
      >
        <!-- Rack Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; font-size: 9px; flex-shrink: 0; line-height: 1;">
          <span style="font-weight: 800; color: #94a3b8; display: flex; align-items: center; gap: 4px; letter-spacing: 0.5px;">
            <i class="icon t4-icons" style="font-size: 11px; color: #00f0ff;">cpu</i>
            8-FILTER MODULAR RACK
          </span>
          <span style="color: #64748b; font-size: 8.5px; font-style: italic; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 65%;">
            ${activePreset.description}
          </span>
        </div>

        <!-- 8 Filter Channel Strips Grid -->
        <div
          class="filter-strips-grid"
          style="display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 2px; flex: 1; height: 100%; min-height: 0;"
        >
          ${activePreset.filters.map((f, idx) => $h`
            <div
              class="filter-channel-strip ${f.bypass ? 'is-bypassed' : ''}"
              key=${`filter-strip-${activePreset.id}-${idx}`}
              style="background: ${f.bypass ? '#060a14' : '#0c1424'}; border: 1px solid ${f.bypass ? '#1a2234' : 'rgba(0, 240, 255, 0.25)'}; border-radius: 5px; padding: 2px 1px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; box-sizing: border-box; opacity: ${f.bypass ? 0.35 : 1.0}; transition: all 0.12s ease; overflow: hidden; min-width: 0;"
            >
              <!-- Strip Top: # and Bypass button -->
              <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-shrink: 0; padding: 0 1px;">
                <span style="font-size: 8px; font-weight: 800; color: #94a3b8; font-family: monospace;">#${f.id}</span>
                <button
                  class="button button-small ${f.bypass ? 'color-gray' : 'button-fill color-green'}"
                  style="height: 12px; line-height: 12px; font-size: 7px; padding: 0 3px; border-radius: 2px; min-width: 18px;"
                  @click=${() => toggleFilterBypass(idx)}
                >
                  ${f.bypass ? 'OFF' : 'ON'}
                </button>
              </div>

              <!-- Strip Filter Type Badge -->
              <div style="text-align: center; margin: 0; flex-shrink: 0;">
                <span class="badge ${f.bypass ? 'color-gray' : 'color-blue'}" style="font-size: 7px; padding: 0 2px; height: 11px; line-height: 11px; font-weight: 800; border-radius: 2px;">
                  ${filterTypeLabels[f.type] || f.type.toUpperCase()}
                </span>
              </div>

              <!-- Circular Slider 1: Frequency / Multiplier -->
              <div
                key=${`f-freq-${activePreset.id}-${idx}`}
                class="round-range-slider round-range-slider-init filter-freq-knob ${f.tracking ? 'freq-tracking' : 'freq-fixed'}"
                data-index=${idx}
                data-mode="0+"
                data-min=${f.tracking ? '0.25' : '30'}
                data-max=${f.tracking ? '16.0' : '14000'}
                data-step=${f.tracking ? '0.05' : '10'}
                data-value=${f.tracking ? f.freqMult : f.freqHz}
                data-default-value=${f.tracking ? f.freqMult : f.freqHz}
                data-snap=${f.tracking ? 'true' : 'false'}
                data-snap-values=${f.tracking ? '[0.5, 1, 1.5, 2, 3, 4, 5, 6, 8, 12, 16]' : '[]'}
                data-snap-threshold=${f.tracking ? '0.18' : '0'}
                data-title="F"
                data-unit=${f.tracking ? '×' : 'Hz'}
                data-size="24"
                data-stroke-width="2.2"
                style="margin: 0 auto !important;"
              ></div>

              <!-- Circular Slider 2: Resonance Q -->
              <div
                key=${`f-q-${activePreset.id}-${idx}`}
                class="round-range-slider round-range-slider-init filter-q-knob"
                data-index=${idx}
                data-mode="0+"
                data-min="0.5"
                data-max="18.0"
                data-step="0.1"
                data-value=${f.q}
                data-default-value=${f.q}
                data-snap="true"
                data-snap-values="[0.7, 1, 2, 4, 8, 12]"
                data-snap-threshold="0.3"
                data-title="Q"
                data-unit=""
                data-size="20"
                data-stroke-width="2.0"
                style="margin: 0 auto !important;"
              ></div>
            </div>
          `)}
        </div>
      </div>

      <!-- Row 4: Polyphonic Touch Piano Keyboard (Bottom Docked) -->
      <div
        class="piano-dock"
        style="height: 95px; flex-shrink: 0; position: relative; border-radius: 7px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.5); user-select: none; touch-action: none;"
      >
        <div class="piano-keyboard" style="display: flex; height: 100%; position: relative;">
          <!-- White Keys -->
          ${whiteKeys.map((k) => $h`
            <div
              class="piano-key white-key"
              data-note=${k.note}
              style="flex: 1; border: 1px solid #1a253a; background: #0d1526; border-radius: 0 0 4px 4px; position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding-bottom: 4px; cursor: pointer; transition: background 0.04s ease;"
              @pointerdown=${(e) => onKeyPointerDown(e, k.note, k.freq)}
              @pointerup=${(e) => onKeyPointerUp(e, k.note)}
              @pointerleave=${(e) => onKeyPointerLeave(e, k.note)}
            >
              <span style="font-size: 10px; font-weight: 800; color: #f8fafc;">${k.note}</span>
              <span style="font-size: 7.5px; color: #64748b;">[${k.keyChar}]</span>
            </div>
          `)}

          <!-- Black Keys -->
          ${blackKeys.map((k) => $h`
            <div
              class="piano-key black-key"
              data-note=${k.note}
              style="position: absolute; left: ${k.offsetPct}%; width: 8.5%; height: 60%; background: #040710; border: 1px solid #1a253a; border-radius: 0 0 3px 3px; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding-bottom: 3px; cursor: pointer; transition: background 0.04s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.8);"
              @pointerdown=${(e) => onKeyPointerDown(e, k.note, k.freq)}
              @pointerup=${(e) => onKeyPointerUp(e, k.note)}
              @pointerleave=${(e) => onKeyPointerLeave(e, k.note)}
            >
              <span style="font-size: 8.5px; font-weight: 700; color: #94a3b8;">${k.note}</span>
            </div>
          `)}
        </div>
      </div>
    </div>

    <!-- Benchmark & Performance Stress Test Modal Overlay -->
    ${showBenchmarkModal ? $h`
      <div class="benchmark-overlay" @click=${(e) => { if (e.target.classList.contains('benchmark-overlay')) closeBenchmarkModal(); }}>
        <div class="benchmark-card">
          <!-- Modal Header -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1a253a; padding-bottom: 8px;">
            <div style="display: flex; align-items: center; gap: 6px;">
              <i class="icon t4-icons" style="font-size: 18px; color: #00f0ff;">speedometer</i>
              <div>
                <div style="font-size: 12px; font-weight: 800; color: #f8fafc; letter-spacing: 0.5px;">SUBUNDERGRUND BENCHMARK</div>
                <div style="font-size: 8.5px; color: #94a3b8;">5-етапний стрес-тест Web Audio API & DSP</div>
              </div>
            </div>
            <button
              class="button button-small button-circle color-gray"
              style="width: 22px; height: 22px; min-width: 22px; line-height: 20px; font-size: 11px; padding: 0;"
              @click=${closeBenchmarkModal}
              :disabled=${isBenchmarking}
            >
              ✕
            </button>
          </div>

          <!-- Testing In Progress View -->
          ${isBenchmarking ? $h`
            <div style="display: flex; flex-direction: column; gap: 8px; padding: 12px 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; font-weight: 700; color: #00f0ff;">
                <span>${benchProgress.name}</span>
                <span>${benchProgress.pct}%</span>
              </div>
              <div class="benchmark-progress-bar-bg">
                <div class="benchmark-progress-bar-fill" style="width: ${benchProgress.pct}%;"></div>
              </div>
              <div style="text-align: center; font-size: 8.5px; color: #64748b; margin-top: 4px; font-family: monospace;">
                Виконується синтез 64 біквадратних фільтрів та замір частоти кадрів...
              </div>
            </div>
          ` : ''}

          <!-- Benchmark Results View -->
          ${!isBenchmarking && benchResults ? $h`
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <!-- Hero Score Box -->
              <div style="background: linear-gradient(135deg, #0c1829 0%, #08101e 100%); border: 1px solid rgba(0, 240, 255, 0.4); border-radius: 8px; padding: 10px; display: flex; align-items: center; justify-content: space-between;">
                <div>
                  <div style="font-size: 8px; font-weight: 800; color: #94a3b8; letter-spacing: 0.5px; text-transform: uppercase;">ЗАГАЛЬНИЙ БАЛ ШВИДКОДІЇ</div>
                  <div style="font-size: 26px; font-weight: 900; color: ${benchResults.score >= 85 ? '#00f0ff' : (benchResults.score >= 70 ? '#f59e0b' : '#ef4444')}; font-family: monospace; line-height: 1.1;">
                    ${benchResults.score}<span style="font-size: 14px; color: #64748b;">/100</span>
                  </div>
                </div>
                <div style="text-align: right;">
                  <span class="badge ${benchResults.score >= 85 ? 'color-green' : (benchResults.score >= 70 ? 'color-orange' : 'color-red')}" style="font-size: 10px; font-weight: 800; padding: 3px 8px;">
                    ${benchResults.grade}
                  </span>
                  <div style="font-size: 8px; color: #94a3b8; margin-top: 4px;">
                    ${benchResults.status}
                  </div>
                </div>
              </div>

              <!-- 4 Metrics Grid -->
              <div class="benchmark-stat-grid">
                <div class="benchmark-stat-box">
                  <span class="benchmark-stat-label">Середній / Мін FPS</span>
                  <span class="benchmark-stat-value">${benchResults.avgFps} <span style="font-size: 10px; color: #64748b;">/ ${benchResults.minFps}</span></span>
                </div>
                <div class="benchmark-stat-box">
                  <span class="benchmark-stat-label">Затримка аудіо буфера</span>
                  <span class="benchmark-stat-value">${benchResults.audioLatencyMs} <span style="font-size: 10px; color: #64748b;">ms</span></span>
                </div>
                <div class="benchmark-stat-box">
                  <span class="benchmark-stat-label">Дропи кадрів (Jank)</span>
                  <span class="benchmark-stat-value" style="color: ${benchResults.droppedFrames === 0 ? '#10b981' : '#f59e0b'};">
                    ${benchResults.droppedFrames} <span style="font-size: 10px; color: #64748b;">кадрів</span>
                  </span>
                </div>
                <div class="benchmark-stat-box">
                  <span class="benchmark-stat-label">DSP Навантаження</span>
                  <span class="benchmark-stat-value">64 <span style="font-size: 10px; color: #64748b;">фільтри</span></span>
                </div>
              </div>

              <!-- Stage Breakdown -->
              <div style="background: #060a14; border: 1px solid #141f33; border-radius: 6px; padding: 6px 8px;">
                <div style="font-size: 8px; font-weight: 800; color: #64748b; margin-bottom: 4px; text-transform: uppercase;">Деталізація етапів:</div>
                <div style="display: flex; flex-direction: column; gap: 2px; font-size: 8.5px; font-family: monospace;">
                  ${benchResults.stages.map((st) => $h`
                    <div style="display: flex; justify-content: space-between; color: #cbd5e1;">
                      <span>${st.name}:</span>
                      <span style="color: #00f0ff;">${st.duration} ms</span>
                    </div>
                  `)}
                </div>
              </div>
            </div>
          ` : ''}

          <!-- Initial Idle State View -->
          ${!isBenchmarking && !benchResults ? $h`
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 9.5px; color: #94a3b8; line-height: 1.4;">
              <p style="margin: 0;">
                Цей бенчмарк вимірює стабільність рендерингу інтерфейсу та здатність процесора обробляти 8 одночасних синтезаторних голосів з 64 каскадними біквадратними фільтрами в реальному часі.
              </p>
              <div style="background: #060a14; border: 1px solid #141f33; border-radius: 6px; padding: 6px 8px; display: flex; flex-direction: column; gap: 3px; font-family: monospace; font-size: 8.5px; color: #cbd5e1;">
                <div>• Етап 1: Базова частота кадрів інтерфейсу (Idle UI)</div>
                <div>• Етап 2: Навантаження 1 голос (8 активних фільтрів)</div>
                <div>• Етап 3: 4-голосний акорд (32 активні фільтри)</div>
                <div>• Етап 4: 8-голосний максимум (64 фільтри + модуляція зрізу)</div>
                <div>• Етап 5: Швидкісне перемикання голосів (16 нот/сек)</div>
              </div>
            </div>
          ` : ''}

          <!-- Footer Action Buttons -->
          <div style="display: flex; gap: 8px; margin-top: 4px;">
            ${!isBenchmarking ? $h`
              <button
                class="button button-fill color-teal"
                style="flex: 1; height: 32px; line-height: 32px; font-size: 11px; font-weight: 800; letter-spacing: 0.5px;"
                @click=${runBenchmark}
              >
                ${benchResults ? 'ПОВТОРИТИ СТРЕС-ТЕСТ' : 'ЗАПУСТИТИ СТРЕС-ТЕСТ'}
              </button>
            ` : $h`
              <button
                class="button button-fill color-gray"
                disabled
                style="flex: 1; height: 32px; line-height: 32px; font-size: 11px; font-weight: 800;"
              >
                ТЕСТУВАННЯ ТРИВАЄ...
              </button>
            `}
            <button
              class="button button-outline color-gray"
              style="height: 32px; line-height: 30px; font-size: 11px; font-weight: 700; min-width: 80px;"
              @click=${closeBenchmarkModal}
              :disabled=${isBenchmarking}
            >
              Закрити
            </button>
          </div>
        </div>
      </div>
    ` : ''}
  </div>
</template>
<script>
import { synthEngine } from '../audio/filter-bank-synth.js';
import { INSTRUMENT_PRESETS } from '../audio/presets.js';
import { perfMonitor, runSynthBenchmark } from '../audio/benchmark.js';

export default (props, { $, $on, $update }) => {
  let isDemoPlaying = false;
  let demoTimerId = null;
  let animFrameId = null;
  let resizeObs = null;

  // Benchmark suite state
  let showBenchmarkModal = false;
  let isBenchmarking = false;
  let benchProgress = { stage: 0, name: '', pct: 0 };
  let benchResults = null;

  const presets = INSTRUMENT_PRESETS;
  let activePreset = synthEngine.getActivePreset();
  let activeVoiceCount = 0;
  const activeKeys = {};

  const filterTypeLabels = {
    lowpass: 'LP',
    highpass: 'HP',
    bandpass: 'BP',
    notch: 'NOTCH',
    peaking: 'PEAK',
    allpass: 'AP',
    lowshelf: 'LS',
    highshelf: 'HS',
  };

  const whiteKeys = [
    { note: 'C4', freq: 261.63, keyChar: 'A' },
    { note: 'D4', freq: 293.66, keyChar: 'S' },
    { note: 'E4', freq: 329.63, keyChar: 'D' },
    { note: 'F4', freq: 349.23, keyChar: 'F' },
    { note: 'G4', freq: 392.00, keyChar: 'G' },
    { note: 'A4', freq: 440.00, keyChar: 'H' },
    { note: 'B4', freq: 493.88, keyChar: 'J' },
    { note: 'C5', freq: 523.25, keyChar: 'K' },
  ];

  const blackKeys = [
    { note: 'C#4', freq: 277.18, offsetPct: 8 },
    { note: 'D#4', freq: 311.13, offsetPct: 20.5 },
    { note: 'F#4', freq: 369.99, offsetPct: 45.5 },
    { note: 'G#4', freq: 415.30, offsetPct: 58 },
    { note: 'A#4', freq: 466.16, offsetPct: 70.5 },
  ];

  function openBenchmarkModal() {
    showBenchmarkModal = true;
    $update();
  }

  function closeBenchmarkModal() {
    if (isBenchmarking) return;
    showBenchmarkModal = false;
    $update();
  }

  async function runBenchmark() {
    if (isBenchmarking) return;
    ensureAudio();
    isBenchmarking = true;
    benchResults = null;
    benchProgress = { stage: 1, name: 'Підготовка до тестування...', pct: 5 };
    $update();

    try {
      const res = await runSynthBenchmark(synthEngine, (prog) => {
        benchProgress = prog;
        $update();
      });
      benchResults = res;
    } catch (err) {
      console.error('Benchmark execution error:', err);
    } finally {
      isBenchmarking = false;
      $update();
    }
  }

  function updateVoiceCountBadge(count) {
    const badge = document.getElementById('ws-voice-count-badge');
    if (!badge) return;
    badge.textContent = `VOICES: ${count}`;
    if (count > 0) {
      badge.className = 'badge color-green';
    } else {
      badge.className = 'badge color-gray';
    }
  }

  function ensureAudio() {
    synthEngine.init();
    synthEngine.resume();
    startOscilloscope();
  }

  function startOscilloscope() {
    if (animFrameId) return;
    const canvas = document.getElementById('audio-workshop-canvas');
    if (!canvas || !synthEngine.analyser) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    const bufferLength = synthEngine.analyser.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);

    function updateCanvasDimensions() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const targetW = Math.floor(rect.width * dpr);
      const targetH = Math.floor(rect.height * dpr);
      if (targetW > 0 && targetH > 0 && (canvas.width !== targetW || canvas.height !== targetH)) {
        canvas.width = targetW;
        canvas.height = targetH;
      }
    }

    if (window.ResizeObserver) {
      if (resizeObs) resizeObs.disconnect();
      resizeObs = new ResizeObserver(() => updateCanvasDimensions());
      resizeObs.observe(canvas);
    }
    updateCanvasDimensions();

    let lastDrawTime = 0;

    function draw(now) {
      animFrameId = requestAnimationFrame(draw);

      // Smart silence throttle: 60 FPS under active audio, throttled ~15 FPS when silent
      let isSilent = true;
      if (synthEngine.getActiveVoiceCount() > 0) {
        isSilent = false;
      } else {
        synthEngine.analyser.getByteTimeDomainData(dataArray);
        for (let i = 0; i < bufferLength; i += 16) {
          if (Math.abs(dataArray[i] - 128) > 2) {
            isSilent = false;
            break;
          }
        }
      }

      const minInterval = isSilent ? 66 : 16;
      if (now - lastDrawTime < minInterval) return;
      lastDrawTime = now;

      const w = canvas.width;
      const h = canvas.height;
      if (!w || !h) return;

      if (!isSilent) {
        synthEngine.analyser.getByteTimeDomainData(dataArray);
      }

      // Deep cyber background
      ctx.fillStyle = '#040711';
      ctx.fillRect(0, 0, w, h);

      // Cyber reticle grid
      ctx.strokeStyle = 'rgba(0, 240, 255, 0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, h / 2);
      ctx.lineTo(w, h / 2);
      ctx.moveTo(w / 2, 0);
      ctx.lineTo(w / 2, h);

      const gridCols = 8;
      const gridRows = 4;
      for (let c = 1; c < gridCols; c += 1) {
        const gx = (w / gridCols) * c;
        ctx.moveTo(gx, 0);
        ctx.lineTo(gx, h);
      }
      for (let r = 1; r < gridRows; r += 1) {
        const gy = (h / gridRows) * r;
        ctx.moveTo(0, gy);
        ctx.lineTo(w, gy);
      }
      ctx.stroke();

      // Dual-pass phosphor wave beam (Zero CPU blur cost, 100% GPU accelerated)
      const sliceWidth = w / (bufferLength - 1);
      let x = 0;

      ctx.beginPath();
      for (let i = 0; i < bufferLength; i += 1) {
        const v = dataArray[i] / 128.0;
        const y = (v * h) / 2;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
        x += sliceWidth;
      }

      // Pass 1: Neon ambient glow
      ctx.lineWidth = 4;
      ctx.strokeStyle = 'rgba(0, 240, 255, 0.28)';
      ctx.stroke();

      // Pass 2: High-definition cyber core beam
      const grad = ctx.createLinearGradient(0, 0, w, 0);
      grad.addColorStop(0, '#00f0ff');
      grad.addColorStop(0.5, '#10b981');
      grad.addColorStop(1, '#00f0ff');
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = grad;
      ctx.stroke();
    }

    animFrameId = requestAnimationFrame(draw);
  }

  function selectInstrument(presetId) {
    ensureAudio();
    activePreset = synthEngine.loadPreset(presetId);
    $update();
  }

  function toggleFilterBypass(idx) {
    const f = activePreset.filters[idx];
    if (!f) return;
    f.bypass = !f.bypass;
    synthEngine.updateFilter(idx, { bypass: f.bypass });
    $update();
  }

  function onFilterFreqChange(idx, val) {
    const f = activePreset.filters[idx];
    if (!f) return;
    if (f.tracking) {
      f.freqMult = val;
      synthEngine.updateFilter(idx, { freqMult: val });
    } else {
      f.freqHz = val;
      synthEngine.updateFilter(idx, { freqHz: val });
    }
  }

  function onFilterQChange(idx, val) {
    const f = activePreset.filters[idx];
    if (!f) return;
    f.q = val;
    synthEngine.updateFilter(idx, { q: val });
  }

  function setWaveform(w) {
    ensureAudio();
    activePreset.waveform = w;
    synthEngine.setWaveform(w);
    $update();
  }

  function playNote(note, freq) {
    ensureAudio();
    activeKeys[note] = true;
    synthEngine.triggerAttack(note, freq, 0.85);
    const keyEl = document.querySelector(`.piano-key[data-note="${note}"]`);
    if (keyEl) keyEl.classList.add('key-pressed');
    updateVoiceCountBadge(synthEngine.getActiveVoiceCount());
  }

  function stopNote(note) {
    delete activeKeys[note];
    synthEngine.triggerRelease(note);
    const keyEl = document.querySelector(`.piano-key[data-note="${note}"]`);
    if (keyEl) keyEl.classList.remove('key-pressed');
    updateVoiceCountBadge(synthEngine.getActiveVoiceCount());
  }

  function panicAllNotesOff() {
    if (demoTimerId) {
      clearInterval(demoTimerId);
      demoTimerId = null;
      isDemoPlaying = false;
      const demoBtn = document.getElementById('ws-demo-btn');
      if (demoBtn) {
        demoBtn.textContent = 'Demo';
        demoBtn.className = 'button button-small button-fill color-blue';
      }
    }
    synthEngine.panic();
    Object.keys(activeKeys).forEach((k) => delete activeKeys[k]);
    document.querySelectorAll('.piano-key.key-pressed').forEach((el) => el.classList.remove('key-pressed'));
    updateVoiceCountBadge(0);
  }

  function onKeyPointerDown(e, note, freq) {
    if (e) e.preventDefault();
    playNote(note, freq);
  }

  function onKeyPointerUp(e, note) {
    if (e) e.preventDefault();
    stopNote(note);
  }

  function onKeyPointerLeave(e, note) {
    stopNote(note);
  }

  function playDemoMelody() {
    if (isDemoPlaying) {
      panicAllNotesOff();
      return;
    }
    ensureAudio();
    isDemoPlaying = true;
    const demoBtn = document.getElementById('ws-demo-btn');
    if (demoBtn) {
      demoBtn.textContent = 'Stop';
      demoBtn.className = 'button button-small button-fill color-orange';
    }
    const melody = [
      { note: 'C4', freq: 261.63, dur: 220 },
      { note: 'E4', freq: 329.63, dur: 220 },
      { note: 'G4', freq: 392.00, dur: 220 },
      { note: 'C5', freq: 523.25, dur: 380 },
      { note: 'B4', freq: 493.88, dur: 220 },
      { note: 'G4', freq: 392.00, dur: 220 },
      { note: 'C4', freq: 261.63, dur: 450 },
    ];
    let step = 0;
    demoTimerId = setInterval(() => {
      if (!isDemoPlaying || step >= melody.length) {
        panicAllNotesOff();
        return;
      }
      playNote(melody[step].note, melody[step].freq);
      setTimeout(() => stopNote(melody[step].note), melody[step].dur - 30);
      step += 1;
    }, 280);
  }

  $on('pageInit', () => {
    ensureAudio();

    // Start Real-Time FPS and Frame-Time HUD Monitor (Direct DOM update, zero VDOM diff)
    perfMonitor.start(({ fps, frameTime }) => {
      const fpsEl = document.getElementById('ws-fps-stat');
      const ftEl = document.getElementById('ws-ft-stat');
      if (fpsEl) {
        fpsEl.textContent = `${fps.toFixed(1)} FPS`;
        if (fps >= 55) fpsEl.style.color = '#00f0ff';
        else if (fps >= 40) fpsEl.style.color = '#f59e0b';
        else fpsEl.style.color = '#ef4444';
      }
      if (ftEl) {
        ftEl.textContent = `${frameTime.toFixed(1)}ms`;
      }
    });

    // Bind Native Techno4 Round Range Sliders (single roundrange:change event)
    $('#ws-volume-knob').on('roundrange:change', (e) => {
      if (e.target.f7RoundRange) {
        synthEngine.setVolume(Math.round(e.target.f7RoundRange.value));
      }
    });

    $('#ws-cutoff-knob').on('roundrange:change', (e) => {
      if (e.target.f7RoundRange) {
        const semitones = e.target.f7RoundRange.value;
        const factor = Math.pow(2, semitones / 12);
        synthEngine.setCutoffBias(factor);
      }
    });

    $('#ws-res-knob').on('roundrange:change', (e) => {
      if (e.target.f7RoundRange) {
        synthEngine.setResonanceBias(e.target.f7RoundRange.value);
      }
    });

    $('#ws-detune-knob').on('roundrange:change', (e) => {
      if (e.target.f7RoundRange) {
        synthEngine.setDetune(e.target.f7RoundRange.value);
      }
    });

    // Bind 8-Filter Modular Rack Knobs via Event Delegation (single roundrange:change event)
    $('.filter-rack-panel').on('roundrange:change', '.filter-freq-knob', function () {
      if (!this.f7RoundRange) return;
      const idx = parseInt(this.getAttribute('data-index'), 10);
      const val = this.f7RoundRange.value;
      onFilterFreqChange(idx, val);
    });

    $('.filter-rack-panel').on('roundrange:change', '.filter-q-knob', function () {
      if (!this.f7RoundRange) return;
      const idx = parseInt(this.getAttribute('data-index'), 10);
      const val = this.f7RoundRange.value;
      onFilterQChange(idx, val);
    });
  });

  $on('pageBeforeRemove', () => {
    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
    if (resizeObs) {
      resizeObs.disconnect();
      resizeObs = null;
    }
    perfMonitor.stop();
    panicAllNotesOff();
  });

  return $render;
};
</script>
