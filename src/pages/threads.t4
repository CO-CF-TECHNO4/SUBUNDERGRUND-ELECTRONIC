<template>
  <div class="page page-threads">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <span class="badge ${serverOnline ? 'color-green' : 'color-red'} margin-right-half">
            <i class="icon t4-icons" style="font-size: 14px; vertical-align: middle;">arrow_branch</i>
            ${serverOnline ? 'ONLINE' : 'OFFLINE'}
          </span>
        </div>
        <div class="title">Threads Studio</div>
        <div class="right">
          <button class="button button-small button-outline color-blue" @click=${checkServer}>
            <i class="icon t4-icons" style="font-size: 14px; vertical-align: middle;">arrow_clockwise</i>
            RELOAD
          </button>
        </div>
      </div>
    </div>

    <div class="page-content" style="height: 100%; display: flex; flex-direction: column; padding: 0 !important; overflow: hidden !important;">
      ${serverOnline ? $h`
        <div style="flex: 1; width: 100%; height: 100%; background: #1e1e1e;">
          <iframe id="threads-studio-frame" src=${serverUrl} style="width: 100%; height: 100%; border: 0;" allow="fullscreen"></iframe>
        </div>
      ` : $h`
        <div class="block block-strong-inset text-align-center" style="max-width: 520px; margin: 48px auto !important; padding: 32px 24px; border-radius: 16px;">
          <i class="icon t4-icons color-gray" style="font-size: 64px; margin-bottom: 16px;">arrow_branch</i>
          <h2>Threads Studio Offline</h2>
          <p class="text-color-gray">
            Локальний сервер потоків даних (<code>techno4-threads</code>) наразі не запущено на порту 8000.
          </p>
          <div class="card card-outline margin-top margin-bottom text-align-left" style="background: rgba(0,0,0,0.03);">
            <div class="card-content card-content-padding font-monospace" style="font-size: 12px;">
              <div># Запустіть серверний стек Threads:</div>
              <div class="text-color-blue font-bold">npm run dev:threads</div>
              <div style="margin-top: 8px;"># Або перевірте статус порту:</div>
              <div class="text-color-blue font-bold">curl http://localhost:8000</div>
            </div>
          </div>
          <p>
            <button class="button button-fill button-round display-inline-block" @click=${checkServer}>
              <i class="icon t4-icons" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">arrow_clockwise</i>
              Перевірити зʼєднання
            </button>
          </p>
        </div>
      `}
    </div>
  </div>
</template>
<script>
export default (props, { $, $on, $update }) => {
  let serverOnline = false;
  let serverUrl = 'http://localhost:8000';

  function checkServer() {
    if (typeof fetch === 'undefined') return;
    fetch(serverUrl, { method: 'HEAD', mode: 'no-cors' })
      .then(() => {
        serverOnline = true;
        $update();
      })
      .catch(() => {
        serverOnline = false;
        $update();
      });
  }

  $on('pageInit', () => {
    checkServer();
  });

  return $render;
};
</script>
